// Redraw the result panel from the stored metric values in the selected units.
void refreshResults() {
  bool grams = addedWeightInGrams();
  bool lbs   = totalWeightInLbs();
  lv_label_set_text(ui_WeightAddedUnitLabel, grams ? "g" : "oz");
  lv_label_set_text(ui_TotalWeightUnitLabel, lbs ? "lbs" : "kg");

  if (!haveResult) {
    lv_label_set_text(ui_WeightAddedValueLabel, "--");
    lv_label_set_text(ui_WeightAngleValueLabel, "--");
    lv_label_set_text(ui_TotalWeightValueLabel, "--");
    return;
  }
  char txt[16];
  snprintf(txt, sizeof(txt), "%.2f", grams ? resMassG : resMassG / 28.3495f);
  lv_label_set_text(ui_WeightAddedValueLabel, txt);
  snprintf(txt, sizeof(txt), "%.2f", resAngleDeg);
  lv_label_set_text(ui_WeightAngleValueLabel, txt);
  snprintf(txt, sizeof(txt), "%.2f", lbs ? resTotalKg * 2.20462f : resTotalKg);
  lv_label_set_text(ui_TotalWeightValueLabel, txt);
}

// ---- tire size, typed as printed on the sidewall
// Understood formats (spaces and a leading P / LT / ST / T are ignored):
//   metric     215/65R15  ST205/75D15  215/65-15   width mm / aspect % / rim in
//   inch       4.80-12  6.00-16  4.80/4.00-8      width in - rim in (sidewall estimated)
//   flotation  18x8.50-8  31x10.50R15  (or *)     diameter in x width in - rim in
static TireSize tire;

static float readNum(const char *&p) {
  float v = 0, scale = 0;
  bool any = false;
  while ((*p >= '0' && *p <= '9') || *p == '.') {
    if (*p == '.') {
      if (scale) break;
      scale = 1;
    } else {
      v = v * 10 + (*p - '0');
      if (scale) scale *= 10;
      any = true;
    }
    p++;
  }
  if (!any) return -1;
  return scale ? v / scale : v;
}
static void skipSpaces(const char *&p)    { while (*p == ' ') p++; }
static void skipNonDigits(const char *&p) { while (*p && !(*p >= '0' && *p <= '9')) p++; }

static bool parseTireSize(const char *in, TireSize &t) {
  char s[32];
  uint8_t n = 0;
  for (const char *q = in; *q && n < sizeof(s) - 1; q++) s[n++] = toupper(*q);
  s[n] = 0;
  const char *p = s;
  skipNonDigits(p);                                   // P, LT, ST ...
  float a = readNum(p);
  if (a <= 0) return false;
  skipSpaces(p);
  if (a >= 60) {                                      // metric: width in mm
    if (*p != '/') return false;
    p++; skipSpaces(p);
    float aspect = readNum(p);
    skipNonDigits(p);
    float rim = readNum(p);                           // stops before a load index ("15 95H")
    if (aspect <= 0 || rim <= 0) return false;
    t.widthMm = a;
    t.sideMm  = a * aspect / 100;
    t.rimMm   = rim * 25.4f;
  } else if (*p == 'X' || *p == '*') {                // flotation: diameter x width - rim
    p++; skipSpaces(p);
    float w = readNum(p);
    skipNonDigits(p);
    float rim = readNum(p);
    if (w <= 0 || rim <= 0 || a <= rim) return false;
    t.widthMm = w * 25.4f;
    t.sideMm  = (a - rim) / 2 * 25.4f;
    t.rimMm   = rim * 25.4f;
  } else {                                            // inch: width - rim
    if (*p == '/') { p++; readNum(p); }               // 4.80/4.00-8: second width ignored
    skipNonDigits(p);
    float rim = readNum(p);
    if (rim <= 0) return false;
    t.widthMm = a * 25.4f;
    t.sideMm  = t.widthMm * INCH_SIZE_ASPECT;
    t.rimMm   = rim * 25.4f;
  }
  return t.widthMm > 50 && t.widthMm < 500 && t.sideMm > 20 && t.sideMm < 400 &&
         t.rimMm > 100 && t.rimMm < 800;
}

// ---- things sent in more than one place
static void sendTireInfo() {
  bool  stickOn  = isChecked(weightPosSw);
  float offsetMm = stickOn ? STICK_ON_OFFSET_MM : CLIP_ON_OFFSET_MM;

  nanoSend("TreadW%.0f", tire.widthMm);
  nanoSend("SideWall%.1f", tire.sideMm / tire.widthMm * 100);    // aspect ratio, %
  nanoSend("RimD%.1f", tire.rimMm);
  nanoSend("WeightR%.1f", tire.rimMm / 2 + offsetMm);
}

static void sendSwitches() {
  nanoSend(isChecked(ui_AutoStopCheckbox) ? "AutoStopOn" : "AutoStopOff");
  nanoSend(isChecked(ui_MassCompSwitch) ? "MassCompOn" : "MassCompOff");
  nanoSend(isChecked(ui_TestWeightSwitch) ? "TestMassOn" : "TestMassOff");
}

// ---- settings kept in the ESP32's flash
static const ScreenPrefs PREF_DEFAULTS = {0, 0, 20, 150, 300, true, true, false, false, false};
static Preferences prefs;
static int16_t  enteredMin = 20, enteredMax = 150, enteredKp = 300;   // last Enter Speed
static uint32_t prefsDirtyAt = 0;

static void setChecked(lv_obj_t *o, bool on) {
  if (on) lv_obj_add_state(o, LV_STATE_CHECKED); else lv_obj_clear_state(o, LV_STATE_CHECKED);
}
static void setSlider(lv_obj_t *s, lv_obj_t *valueLabel, int v) {
  lv_slider_set_value(s, v, LV_ANIM_OFF);
  lv_label_set_text_fmt(valueLabel, "%d", v);
}

static void prefsLoad(ScreenPrefs &p) {
  const ScreenPrefs &d = PREF_DEFAULTS;
  prefs.begin("tb", true);
  p.pitchTrim = prefs.getShort("pt", d.pitchTrim);
  p.rollTrim  = prefs.getShort("rt", d.rollTrim);
  p.minSpeed  = prefs.getShort("min", d.minSpeed);
  p.maxSpeed  = prefs.getShort("max", d.maxSpeed);
  p.kp        = prefs.getShort("kp", d.kp);
  p.massComp  = prefs.getBool("mc", d.massComp);
  p.autoStop  = prefs.getBool("as", d.autoStop);
  p.grams     = prefs.getBool("g", d.grams);
  p.lbs       = prefs.getBool("lb", d.lbs);
  p.stickOn   = prefs.getBool("so", d.stickOn);
  prefs.end();
}

// Put saved values on the widgets (does not send anything to the Nano).
static void prefsApply(const ScreenPrefs &p) {
  setSlider(ui_PitchOffsetSlider, ui_PitchOffsetValueLabel, p.pitchTrim);
  setSlider(ui_RollOffsetSlider, ui_RollOffsetValueLabel, p.rollTrim);
  setSlider(ui_MinSpeedSlider, ui_MinSpeedValueLabel, p.minSpeed);
  setSlider(ui_MaxSpeedSlider, ui_MaxSpeedValueLabel, p.maxSpeed);
  setSlider(ui_SpeedCurveSlider, ui_SpeedCurveValueLabel, p.kp);
  enteredMin = p.minSpeed;
  enteredMax = p.maxSpeed;
  enteredKp  = p.kp;
  setChecked(ui_MassCompSwitch, p.massComp);
  setChecked(ui_AutoStopCheckbox, p.autoStop);
  setChecked(ui_TestWeightSwitch1, p.grams);
  setChecked(ui_TestWeightSwitch2, p.lbs);
  setChecked(weightPosSw, p.stickOn);
  refreshResults();                                  // units labels
}

// Write the current widget state (speeds: as last entered). Called ~1.5 s
// after the last change, so dragging a slider does not wear the flash.
static void prefsWriteNow() {
  prefs.begin("tb", false);
  prefs.putShort("pt", lv_slider_get_value(ui_PitchOffsetSlider));
  prefs.putShort("rt", lv_slider_get_value(ui_RollOffsetSlider));
  prefs.putShort("min", enteredMin);
  prefs.putShort("max", enteredMax);
  prefs.putShort("kp", enteredKp);
  prefs.putBool("mc", isChecked(ui_MassCompSwitch));
  prefs.putBool("as", isChecked(ui_AutoStopCheckbox));
  prefs.putBool("g", isChecked(ui_TestWeightSwitch1));
  prefs.putBool("lb", isChecked(ui_TestWeightSwitch2));
  prefs.putBool("so", isChecked(weightPosSw));
  prefs.end();
  Serial.println("! settings saved");
}
static void prefsDirty() { prefsDirtyAt = millis() | 1; }
static void prefsTick(uint32_t now) {
  if (prefsDirtyAt && now - prefsDirtyAt > 1500) { prefsDirtyAt = 0; prefsWriteNow(); }
}

// Everything the Nano should use from the screen. Sent whenever the link comes
// up (after every handshake), so saved settings apply after a power cycle.
static void syncNano() {
  sendSwitches();
  nanoSend("MinSpeed%d", enteredMin);
  nanoSend("MaxSpeed%d", enteredMax);
  nanoSend("Kp%d", enteredKp);
  nanoSend("PitchTrim%.1f", lv_slider_get_value(ui_PitchOffsetSlider) / 10.0f);
  nanoSend("RollTrim%.1f", lv_slider_get_value(ui_RollOffsetSlider) / 10.0f);
  nanoSend("LaserAngle%d", (int)lv_slider_get_value(ui_ManualLaserAngleSlider));
  nanoSend(isChecked(ui_ManualLaserSwitch) ? "ManualLaserOn" : "ManualLaserOff");
  if (tireEntered) sendTireInfo();
}

// ============================================================ receiving from the Nano
static const char *errorText(const char *code) {
  if (!strcasecmp(code, "Busy"))         return "The Nano is busy with something else.";
  if (!strcasecmp(code, "BaseTilt"))     return "The frame is tilted too far: the platform cannot reach level. Move it to flatter ground.";
  if (!strcasecmp(code, "Reach"))        return "Measuring the platform's range of motion failed.";
  if (!strcasecmp(code, "Axes"))         return "An MPU mounting setting is invalid (TopAxis / BaseAxis).";
  if (!strcasecmp(code, "MPUTop"))       return "Platform angle sensor is not responding.";
  if (!strcasecmp(code, "MPUBottom"))    return "Frame angle sensor is not responding.";
  if (!strcasecmp(code, "LevelTimeout")) return "Leveling took too long and was stopped.";
  if (!strcasecmp(code, "Scale"))        return "A load cell is not responding.";
  if (!strcasecmp(code, "TireData"))     return "Enter the tire size on the Tire Info tab first.";
  if (!strcasecmp(code, "NoLoad"))       return "No tire detected on the load cells.";
  if (!strcasecmp(code, "NoTare"))       return "Press Tare with the arms empty first.";
  if (!strcasecmp(code, "Cal"))          return "Load cell calibration failed.";
  return code;
}

// Value of "Key<number>" inside a line, e.g. findValue(line, "WeightMass", v)
static bool findValue(const char *line, const char *key, float &value) {
  const char *p = strstr(line, key);
  if (!p) return false;
  p += strlen(key);
  char *end;
  value = strtof(p, &end);
  return end != p;
}

static void handleNanoLine(char *line) {
  Serial.printf("< %s\n", line);                     // USB log: everything heard from the Nano

  // Our own commands coming back means RX hears TX: on a level converter
  // this happens when its LV pin is not on 3.3 V (the channels' pull-ups
  // then tie them together). Never count that as the Nano.
  if (!strncmp(line, "Ping", 4) || !strncmp(line, "Ack", 3)) {
    rxBadLines++;
    statusNote("RX hears own TX");
    lv_obj_set_style_text_color(statusLabel, lv_palette_main(LV_PALETTE_RED), 0);
    return;
  }

  // Checksum: "*XX" at the end, XOR of everything before the '*'
  char *star = strrchr(line, '*');
  if (star) {
    uint8_t x = 0;
    for (char *p = line; p < star; p++) x ^= (uint8_t)*p;
    if (strlen(star + 1) != 2 || (uint8_t)strtol(star + 1, NULL, 16) != x) {          // damaged: the Nano will resend
      rxBadLines++;
      return;
    }
    *star = 0;
  }
  else if (line[0] != '#' && strncmp(line, "Pong", 4) && strncmp(line, "Ready", 5)) {
    rxBadLines++;                                    // nothing else is ever sent without a checksum
    return;
  }

  // Only lines the Nano itself sends prove the link is up.
  bool fromNano = line[0] == '#' || !strncmp(line, "Pong", 4) || !strncmp(line, "Ready", 5) ||
                  !strncmp(line, "LevelCompleted", 14) || !strncmp(line, "TareCompleted", 13) ||
                  !strncmp(line, "BalanceCompleted", 16) || !strncmp(line, "Err ", 4);
  if (!fromNano) {
    rxBadLines++;
    return;
  }

  lastHeardMs = millis();
  bool wasUp = linkUp;
  if (!linkUp) {
    linkUp = true;
    Serial.println("! link up");
    showLinkState();
    syncNano();
  }

  if (line[0] == '#') return;                        // debug text for humans
  if (!strncmp(line, "Pong", 4)) return;
  if (!strncmp(line, "Ready", 5)) {                  // the Nano has just restarted
    if (wasUp) syncNano();
    return;
  }

  // Everything else is an event, and the Nano repeats events until it gets an Ack.
  // Ack every copy, but act on it only once.
  static char     lastEvent[48] = "";
  static uint32_t lastEventMs   = 0;
  if (!strcmp(line, lastEvent) && millis() - lastEventMs < 3000) {
    nanoSend("Ack");
    return;
  }
  strncpy(lastEvent, line, sizeof(lastEvent) - 1);
  lastEventMs = millis();

  if (!strncmp(line, "LevelCompleted", 14)) {
    nanoSend("Ack");
    if (waiting == WAIT_LEVEL) {
      waiting = WAIT_NONE;
      backToOptionMenu();
      statusNote(reachRunning ? "Limits saved, level" : "Level done");
      reachRunning = false;
    }
  }
  else if (!strncmp(line, "TareCompleted", 13)) {
    nanoSend("Ack");
    if (waiting == WAIT_TARE) {
      waiting = WAIT_NONE;
      statusNote("Tare done");
    }
  }
  else if (!strncmp(line, "BalanceCompleted", 16)) {
    float angle, mass, total;
    if (!findValue(line, "WeightAngle", angle) || !findValue(line, "WeightMass", mass) || !findValue(line, "TotalWeight", total)) return;
    nanoSend("Ack");
    resAngleDeg = angle;
    resMassG    = mass;
    resTotalKg  = total;
    haveResult  = true;
    refreshResults();
    if (waiting == WAIT_BALANCE) {
      waiting = WAIT_NONE;
      backToOptionMenu();
    }
  }
  else if (!strncmp(line, "Err ", 4)) {
    nanoSend("Ack");
    waiting = WAIT_NONE;
    reachRunning = false;
    backToOptionMenu();
    showMessage("Error", errorText(line + 4));
  }
}

static void nanoReceiveTick() {
  static char    rx[96];
  static uint8_t rxLen = 0;
  static bool    rxOverflow = false;

  while (NanoSerial.available()) {
    char c = NanoSerial.read();
    rxBytes++;
    uint8_t b = (uint8_t)c;
    if (b > 0x7E || (b < 0x20 && c != '\n' && c != '\r' && c != '\t')) {
      // One stray byte (e.g. while either board restarts) is not "noise";
      // pause sending only for several within half a second (Nano upload).
      static uint32_t noiseFirst = 0;
      static uint8_t  noiseCount = 0;
      if (millis() - noiseFirst > 500) { noiseFirst = millis(); noiseCount = 0; }
      if (++noiseCount >= NOISE_BYTES) {
        if (!quiet) {
          quiet = true;
          Serial.printf("! non-text bytes on RX - pausing sends\n");
          showLinkState();
        }
        quietUntil = millis() + QUIET_MS;
      }
      rxOverflow = true;                             // drop this line
      continue;
    }
    if (c == '\n' || c == '\r') {
      if (rxLen > 0 && !rxOverflow) {
        rx[rxLen] = 0;
        handleNanoLine(rx);
      } else if (rxOverflow) {
        rxBadLines++;
      }
      rxLen = 0;
      rxOverflow = false;
    } else if (rxLen < sizeof(rx) - 1) {
      rx[rxLen++] = c;
    } else {
      rxOverflow = true;
    }
  }
}

// Ping, link state, timeouts and throttled slider values.
static void linkTick(uint32_t now) {
  if (quiet && (int32_t)(now - quietUntil) >= 0) {
    quiet = false;
    showLinkState();
  }

  if (now - lastPingMs >= PING_PERIOD_MS) {
    lastPingMs = now;
    if (!quiet) nanoSend("Ping");
    if (!linkUp && !statusNoteUntil) showLinkState();      // keep the rx / bad counters fresh
  }

  if (linkUp && (int32_t)(now - lastHeardMs) > (int32_t)LINK_TIMEOUT_MS) {
    linkUp = false;
    Serial.println("! link down");
    showLinkState();
  }

  if (statusNoteUntil && (int32_t)(now - statusNoteUntil) >= 0) {
    statusNoteUntil = 0;
    showLinkState();
  }

  if (waiting != WAIT_NONE && waitDeadline && (int32_t)(now - waitDeadline) >= 0) {
    waiting = WAIT_NONE;
    nanoSendNow("Stop");
    backToOptionMenu();
    showMessage("No reply", "The Nano did not answer in time. Check the serial wires (see docs/Wiring.md).");
  }

  if (now - lastSliderSendMs >= 100) {
    if (pitchTrimPending) {
      pitchTrimPending = false; lastSliderSendMs = now;
      nanoSend("PitchTrim%.1f", lv_slider_get_value(ui_PitchOffsetSlider) / 10.0f);
    } else if (rollTrimPending) {
      rollTrimPending = false; lastSliderSendMs = now;
      nanoSend("RollTrim%.1f", lv_slider_get_value(ui_RollOffsetSlider) / 10.0f);
    } else if (laserAnglePending) {
      laserAnglePending = false; lastSliderSendMs = now;
      nanoSend("LaserAngle%d", (int)lv_slider_get_value(ui_ManualLaserAngleSlider));
    }
  }
}

