// ------------------------------------------------------------ Nano link
// The Nano link uses IO35 (RX) and IO22 (TX), NOT the 4-pin serial
// connector's RXD/TXD (GPIO 3/1). Those are wired to the board's own
// USB-serial chip, which held RXD high so the Nano's replies never arrived
// (rx:0). Both ESP32 pins are 3.3 V logic: go through the level converter
// with its LV pin on 3.3 V. The USB port (Serial, 115200) now prints a log
// of every line sent ("> ") and received ("< ").
#define NANO_BAUD    9600        // must match SERIAL_BAUD in the Nano's Config.h
#define NANO_RX_PIN  35
#define NANO_TX_PIN  22
#define LOG_BAUD     115200      // USB log
#define NanoSerial   Serial1

#define PING_PERIOD_MS     2000     // how often to check the Nano is there
#define LINK_TIMEOUT_MS    5000     // nothing heard for this long = link down
#define SEND_GAP_MS        30       // pause between queued commands (the Nano's buffer is small)
#define LEVEL_TIMEOUT_MS   130000   // a little longer than the Nano's own limit
#define REACH_TIMEOUT_MS   200000   // FindReach: 4 end-stop legs (up to 40 s each) + leveling
#define BALANCE_TIMEOUT_MS 8000
#define TARE_TIMEOUT_MS    5000

// ------------------------------------------------------------ balance weight position
// The tire code gives the rim's bead seat diameter. The weight does not sit
// exactly there, so its radius is the rim radius plus one of these offsets.
// ESTIMATES - measure your wheels and weights and adjust.
#define CLIP_ON_OFFSET_MM    10.0f    // clip-on weight on the rim flange (outside the bead seat)
#define STICK_ON_OFFSET_MM  -15.0f    // stick-on weight inside the barrel

// Older inch sizes (4.80-12) give no aspect ratio. Sidewall height is taken
// as this fraction of the width (published diameters of such tires give
// about 0.9-0.98). For an exact value type the flotation form with the
// measured overall diameter instead, e.g. 21.4x4.80-12.
#define INCH_SIZE_ASPECT     0.95f

// Defined up here because the Arduino IDE puts its generated function
// prototypes above the first function, and they use this type.
struct TireSize { float widthMm, sideMm, rimMm; };

// Debug/user settings the screen keeps in its own flash and sends to the Nano
// after every handshake. PREF_DEFAULTS are the "factory defaults" (the values
// tuned on the machine, 2026-11-14). Manual Laser and Test Weight are not kept.
struct ScreenPrefs {
  int16_t pitchTrim, rollTrim;           // tenths of a degree
  int16_t minSpeed, maxSpeed, kp;        // as last sent with Enter Speed
  bool    massComp, autoStop;
  bool    grams, lbs;                    // units: added weight in g, total weight in lbs
  bool    stickOn;                       // Tire Info: Stick-on (else Clip-on)
};

// A tire size format for the number pad: a list of parts; the separator after
// each part is filled in automatically. autoLen: jump to the next part after
// this many digits (0 = press Next).
struct TireFmt {
  uint8_t     n;
  const char *ph[3];      // placeholder shown until the part is typed
  const char *sep[3];     // text after each part
  const char *hint[3];    // what the part is
  uint8_t     autoLen[3];
};

