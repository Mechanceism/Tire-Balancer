  lv_obj_align(fl, LV_ALIGN_TOP_LEFT, 0, 10);
  tireFmtDd = lv_dropdown_create(ui_Tire_Info_Tab);
  lv_dropdown_set_options(tireFmtDd, "Metric 215/65R15\nInch 4.80-12\nFlotation 31x10.50-15");
  lv_obj_set_width(tireFmtDd, 190);
  lv_obj_align(tireFmtDd, LV_ALIGN_TOP_LEFT, 60, 0);
  lv_obj_add_event_cb(tireFmtDd, tireFmt_event_cb, LV_EVENT_VALUE_CHANGED, NULL);

  // Row 2: the size - a big button that opens the number pad
  lv_obj_t *sl = lv_label_create(ui_Tire_Info_Tab);
  lv_label_set_text(sl, "Size:");
  lv_obj_align(sl, LV_ALIGN_TOP_LEFT, 0, 58);
  lv_obj_t *sizeBtn = lv_btn_create(ui_Tire_Info_Tab);
  lv_obj_set_size(sizeBtn, 150, 44);
  lv_obj_align(sizeBtn, LV_ALIGN_TOP_LEFT, 60, 46);
  lv_obj_set_style_bg_color(sizeBtn, lv_color_white(), 0);
  lv_obj_set_style_border_width(sizeBtn, 2, 0);
  lv_obj_set_style_border_color(sizeBtn, lv_palette_main(LV_PALETTE_BLUE), 0);
  lv_obj_add_event_cb(sizeBtn, tireSize_event_cb, LV_EVENT_CLICKED, NULL);
  tireSizeLbl = lv_label_create(sizeBtn);
  lv_label_set_recolor(tireSizeLbl, true);
  lv_obj_set_style_text_color(tireSizeLbl, lv_color_black(), 0);
  lv_obj_center(tireSizeLbl);

  lv_obj_set_size(ui_TireInfoEnterButton, 80, 44);
  lv_obj_align(ui_TireInfoEnterButton, LV_ALIGN_TOP_RIGHT, 0, 46);

  // Row 3: what the size means
  tireResult = lv_label_create(ui_Tire_Info_Tab);
  lv_obj_align(tireResult, LV_ALIGN_TOP_LEFT, 0, 98);

  // Row 4: Clip-on [switch] Stick-on
  lv_obj_t *cl = lv_label_create(ui_Tire_Info_Tab);
  lv_label_set_text(cl, "Clip-on");
  lv_obj_align(cl, LV_ALIGN_TOP_LEFT, 0, 146);
  weightPosSw = lv_switch_create(ui_Tire_Info_Tab);
  lv_obj_set_size(weightPosSw, 60, 30);
  lv_obj_align(weightPosSw, LV_ALIGN_TOP_LEFT, 66, 140);
  lv_obj_add_event_cb(weightPosSw, WeightPos_event_cb, LV_EVENT_VALUE_CHANGED, NULL);
  lv_obj_t *stl = lv_label_create(ui_Tire_Info_Tab);
  lv_label_set_text(stl, "Stick-on");
  lv_obj_align(stl, LV_ALIGN_TOP_LEFT, 136, 146);

  // Full-screen number pad, on top of everything, hidden until the size is tapped
  static const char *padMap[] = {"1", "2", "3", LV_SYMBOL_BACKSPACE, "\n",
                                 "4", "5", "6", "Next", "\n",
                                 "7", "8", "9", "Cancel", "\n",
                                 ".", "0", "Done", ""};
  tirePad = lv_obj_create(lv_layer_top());
  lv_obj_set_size(tirePad, LV_PCT(100), LV_PCT(100));
  lv_obj_set_style_pad_all(tirePad, 4, 0);
  lv_obj_set_style_radius(tirePad, 0, 0);
  lv_obj_clear_flag(tirePad, LV_OBJ_FLAG_SCROLLABLE);
  tirePadHead = lv_label_create(tirePad);
  lv_label_set_recolor(tirePadHead, true);
  lv_obj_set_style_text_align(tirePadHead, LV_TEXT_ALIGN_CENTER, 0);
  lv_obj_set_width(tirePadHead, LV_PCT(100));
  lv_obj_align(tirePadHead, LV_ALIGN_TOP_MID, 0, 0);
  lv_obj_t *pad = lv_btnmatrix_create(tirePad);
  lv_btnmatrix_set_map(pad, padMap);
  lv_btnmatrix_set_btn_width(pad, 14, 2);                 // "Done" is double width
  lv_btnmatrix_set_btn_ctrl_all(pad, LV_BTNMATRIX_CTRL_NO_REPEAT);   // holding a key types it once
  lv_obj_set_size(pad, LV_PCT(100), 190);
  lv_obj_align(pad, LV_ALIGN_BOTTOM_MID, 0, 0);
  lv_obj_add_event_cb(pad, padKey_event_cb, LV_EVENT_VALUE_CHANGED, NULL);
  lv_obj_add_flag(tirePad, LV_OBJ_FLAG_HIDDEN);
  showTireResult();

  // Debug tab: the old "Speed Curve Exp." slider is now the leveling PID gain.
  // Slider start values match the Nano's tuned defaults (Settings.ino), so
  // pressing "Enter Speed" without moving them changes nothing.
  lv_label_set_text(ui_SpeedCurveSliderLabel, "Level Gain Kp");
  lv_slider_set_range(ui_SpeedCurveSlider, 10, 400);
  lv_slider_set_value(ui_SpeedCurveSlider, 300, LV_ANIM_OFF);
  lv_label_set_text(ui_SpeedCurveValueLabel, "300");
  lv_slider_set_value(ui_MinSpeedSlider, 20, LV_ANIM_OFF);
  lv_label_set_text(ui_MinSpeedValueLabel, "20");
  lv_slider_set_value(ui_MaxSpeedSlider, 150, LV_ANIM_OFF);
  lv_label_set_text(ui_MaxSpeedValueLabel, "150");

  // Debug tab: these trim the Nano's saved offsets by up to +-1.0 deg
  lv_label_set_text(ui_PitchOffsetSliderLabel, "Pitch Trim (deg tenths)");
  lv_label_set_text(ui_RollOffsetSliderLabel, "Roll Trim (deg tenths)");

  // Debug tab: Find Reach button, below the existing controls
  lv_obj_t *reachBtn = lv_btn_create(ui_Debug_Tab);
  lv_obj_set_size(reachBtn, 140, 45);
  lv_obj_set_align(reachBtn, LV_ALIGN_CENTER);
  lv_obj_set_y(reachBtn, lv_pct(200));
  lv_obj_add_event_cb(reachBtn, reachButton_event_cb, LV_EVENT_CLICKED, NULL);
  lv_obj_t *reachLbl = lv_label_create(reachBtn);
  lv_label_set_text(reachLbl, "Find Reach");
  lv_obj_center(reachLbl);

  // Debug tab: Restore Factory Defaults, at the very bottom
  lv_obj_t *restoreBtn = lv_btn_create(ui_Debug_Tab);
  lv_obj_set_size(restoreBtn, 220, 45);
  lv_obj_set_align(restoreBtn, LV_ALIGN_CENTER);
  lv_obj_set_y(restoreBtn, lv_pct(230));
  lv_obj_set_style_bg_color(restoreBtn, lv_palette_main(LV_PALETTE_RED), 0);
  lv_obj_add_event_cb(restoreBtn, restoreButton_event_cb, LV_EVENT_CLICKED, NULL);
  lv_obj_t *restoreLbl = lv_label_create(restoreBtn);
  lv_label_set_text(restoreLbl, "Restore Factory Defaults");
  lv_obj_center(restoreLbl);

  // Debug tab, top re-laid out for laser calibration:
  //   [Manual Laser]  [Set 90]
  //   Laser Angle (deg)
  //   [-]  ====slider====  value  [+]
  // Everything else on the tab moves down to make room.
  {
    lv_obj_update_layout(ui_Debug_Tab);
    lv_coord_t W = lv_obj_get_content_width(ui_Debug_Tab);
    lv_coord_t H = lv_obj_get_content_height(ui_Debug_Tab);
    auto px = [](lv_coord_t v, lv_coord_t full) -> lv_coord_t {    // resolve lv_pct() to pixels
      return LV_COORD_IS_PCT(v) ? (lv_coord_t)((int32_t)LV_COORD_GET_PCT(v) * full / 100) : v;
    };
    auto X = [&](lv_obj_t *o) { return px(lv_obj_get_style_x(o, LV_PART_MAIN), W); };
    auto Y = [&](lv_obj_t *o) { return px(lv_obj_get_style_y(o, LV_PART_MAIN), H); };

    // The laser angle row is a copy of the Pitch Trim row, one row higher:
    // the same distance as Pitch Trim is above Roll Trim.
    lv_coord_t row = Y(ui_RollOffsetSlider) - Y(ui_PitchOffsetSlider);
    lv_coord_t top = -H / 2;                         // CENTER-aligned offsets from the tab middle
    const lv_coord_t SWITCH_ABOVE = 36;             // switch row centre above the laser title
    // Move everything else down just enough for the switch row to fit at the top.
    lv_coord_t shift = (top + 2 + 20 + SWITCH_ABOVE) - (Y(ui_PitchOffsetSliderLabel) - row);
    if (shift < 0) shift = 0;

    // Remember the Pitch row (before it moves) to copy from
    lv_coord_t pLabX = X(ui_PitchOffsetSliderLabel), pLabY = Y(ui_PitchOffsetSliderLabel);
    lv_coord_t pSldX = X(ui_PitchOffsetSlider),      pSldY = Y(ui_PitchOffsetSlider);
    lv_coord_t pValX = X(ui_PitchOffsetValueLabel),  pValY = Y(ui_PitchOffsetValueLabel);
    lv_coord_t pMinX = X(ui_PitchOffsetMinButton),   pMinY = Y(ui_PitchOffsetMinButton);
    lv_coord_t pPlsX = X(ui_PitchOffsetPlusButton),  pPlsY = Y(ui_PitchOffsetPlusButton);

    lv_obj_t *laserObjs[] = {ui_ManualLaserSwitch, ui_ManualLaserAngleSlider,
                             ui_ManualLaserAngleLabel, ui_ManualLaserAngleValueLabel};
    uint32_t n = lv_obj_get_child_cnt(ui_Debug_Tab);
    for (uint32_t i = 0; i < n; i++) {
      lv_obj_t *c = lv_obj_get_child(ui_Debug_Tab, i);
      bool isLaser = false;
      for (lv_obj_t *o : laserObjs) if (o == c) isLaser = true;
      if (!isLaser) lv_obj_set_y(c, Y(c) + shift);
    }
    lv_coord_t dy = shift - row;                     // pitch row position -> laser row position

    lv_obj_set_align(ui_ManualLaserAngleLabel, LV_ALIGN_CENTER);
    lv_obj_set_pos(ui_ManualLaserAngleLabel, pLabX, pLabY + dy);
    lv_obj_set_align(ui_ManualLaserAngleSlider, LV_ALIGN_CENTER);
    lv_obj_set_size(ui_ManualLaserAngleSlider, lv_obj_get_width(ui_PitchOffsetSlider), lv_obj_get_height(ui_PitchOffsetSlider));
    lv_obj_set_pos(ui_ManualLaserAngleSlider, pSldX, pSldY + dy);
    lv_obj_set_align(ui_ManualLaserAngleValueLabel, LV_ALIGN_CENTER);
    lv_obj_set_pos(ui_ManualLaserAngleValueLabel, pValX, pValY + dy);
    for (int k = 0; k < 2; k++) {
      lv_obj_t *src = k ? ui_PitchOffsetPlusButton : ui_PitchOffsetMinButton;
      lv_obj_t *b = lv_btn_create(ui_Debug_Tab);
      lv_obj_set_size(b, lv_obj_get_width(src), lv_obj_get_height(src));
      lv_obj_set_align(b, LV_ALIGN_CENTER);
      lv_obj_set_pos(b, k ? pPlsX : pMinX, (k ? pPlsY : pMinY) + dy);
      lv_obj_add_event_cb(b, laserStep_event_cb, LV_EVENT_CLICKED, (void *)(intptr_t)(k ? 1 : -1));
      lv_obj_t *bl = lv_label_create(b);
      lv_label_set_text(bl, k ? "+" : "-");
      lv_obj_center(bl);
    }

    // Switch row above the laser title: [Manual Laser] [Set 90]
    lv_coord_t swY = pLabY + dy - SWITCH_ABOVE;
    lv_obj_set_align(ui_ManualLaserSwitch, LV_ALIGN_CENTER);
    lv_obj_set_pos(ui_ManualLaserSwitch, -60, swY);
    lv_obj_t *set90 = lv_btn_create(ui_Debug_Tab);
    lv_obj_set_size(set90, 90, 40);
    lv_obj_set_align(set90, LV_ALIGN_CENTER);
    lv_obj_set_pos(set90, 60, swY);
    lv_obj_add_event_cb(set90, laserSet90_event_cb, LV_EVENT_CLICKED, NULL);
    lv_obj_t *s90l = lv_label_create(set90);
    lv_label_set_text(s90l, "Set 90");
    lv_obj_center(s90l);
  }

  // Tire Info tab: Recents, below the size controls (the tab scrolls)
  lv_obj_t *rl = lv_label_create(ui_Tire_Info_Tab);
  lv_label_set_text(rl, "Recent sizes (tap to use):");
  lv_obj_align(rl, LV_ALIGN_TOP_LEFT, 0, 186);
  for (uint8_t i = 0; i < RECENT_N; i++) {
    recentBtn[i] = lv_btn_create(ui_Tire_Info_Tab);
    lv_obj_set_size(recentBtn[i], 250, 38);
    lv_obj_align(recentBtn[i], LV_ALIGN_TOP_LEFT, 0, 210 + i * 44);
    lv_obj_add_event_cb(recentBtn[i], recent_event_cb, LV_EVENT_CLICKED, (void *)(intptr_t)i);
    recentLbl[i] = lv_label_create(recentBtn[i]);
    lv_obj_align(recentLbl[i], LV_ALIGN_LEFT_MID, 4, 0);
  }

  // Saved settings and Recents from the ESP32's flash
  ScreenPrefs p;
  prefsLoad(p);
  prefsApply(p);
  recentsLoad();
  recentsShow();

  // Result panel starts empty instead of showing placeholder text
  refreshResults();
}

void setup() {
  Wire.begin(I2C_SDA, I2C_SCL);
  Serial.begin(LOG_BAUD);
  Serial.println("\nTire balancer screen " SCREEN_FW_VERSION " - Nano link: RX IO35, TX IO22");
  NanoSerial.begin(NANO_BAUD, SERIAL_8N1, NANO_RX_PIN, NANO_TX_PIN);

  lv_init();

  tft.begin();          /* TFT init */
  tft.setRotation( 1 ); /* Landscape orientation, flipped */

  lv_disp_draw_buf_init( &draw_buf, buf, NULL, screenWidth * screenHeight / 10 );

  /*Initialize the display*/
  static lv_disp_drv_t disp_drv;
  lv_disp_drv_init( &disp_drv );
  disp_drv.hor_res = screenWidth;
  disp_drv.ver_res = screenHeight;
  disp_drv.flush_cb = my_disp_flush;
  disp_drv.draw_buf = &draw_buf;
  lv_disp_drv_register( &disp_drv );

  /*Initialize the input device driver*/
  static lv_indev_drv_t indev_drv;
  lv_indev_drv_init( &indev_drv );
  indev_drv.type = LV_INDEV_TYPE_POINTER;
  indev_drv.read_cb = my_touchpad_read;
  lv_indev_drv_register( &indev_drv );

  ui_init();
  setupExtraWidgets();

  // Buttons
  lv_obj_add_event_cb(ui_CalibrateButton, CalibrateButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_LaserButton, LaserButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_BalanceButton, BalanceButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_BalanceCancelButton, BalanceCancelButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_LevelButton, LevelButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_LevelCancelButton, LevelCancelButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_TireInfoEnterButton, TireInfoEnterButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_SpeedEnterButton, SpeedEnterButton_event_handler, LV_EVENT_ALL, NULL);
  // Sliders
  lv_obj_add_event_cb(ui_PitchOffsetSlider, PitchOffsetSlider_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_RollOffsetSlider, RollOffsetSlider_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_ManualLaserAngleSlider, ManualLaserAngleSlider_event_handler, LV_EVENT_ALL, NULL);
  // Switches
  lv_obj_add_event_cb(ui_TestWeightSwitch, TestWeightSwitch_event_cb, LV_EVENT_VALUE_CHANGED, NULL);
  lv_obj_add_event_cb(ui_MassCompSwitch, MassCompSwitch_event_cb, LV_EVENT_VALUE_CHANGED, NULL);
  lv_obj_add_event_cb(ui_ManualLaserSwitch, ManualLaserSwitch_event_cb, LV_EVENT_VALUE_CHANGED, NULL);
  lv_obj_add_event_cb(ui_TestWeightSwitch1, UnitsSwitch_event_cb, LV_EVENT_VALUE_CHANGED, NULL);   // added weight: oz / g
  lv_obj_add_event_cb(ui_TestWeightSwitch2, UnitsSwitch_event_cb, LV_EVENT_VALUE_CHANGED, NULL);   // total weight: kg / lbs
  // Checkbox
  lv_obj_add_event_cb(ui_AutoStopCheckbox, AutoStopCheckbox_event_handler, LV_EVENT_VALUE_CHANGED, NULL);
}

void loop()
{
  lv_timer_handler(); /* let the GUI do its work */
  screenTick();       // screen changes requested by Nano events, once no animation runs

  // Receive first, THEN read the clock, so lastHeardMs can never be later
  // than "now" (that made "now - lastHeardMs" wrap and drop the link).
  nanoReceiveTick();
  usbPassthroughTick();
  uint32_t now = millis();
  linkTick(now);
  nanoSendTick(now);
  prefsTick(now);     // save changed settings ~1.5 s after the last change

  delay(5);
}
