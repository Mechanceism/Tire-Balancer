/*
  Self Leveling Static Tire Balancer - touch screen (ESP32 "CYD" JC2432W328C)

  The screen is only the user interface. It sends short text commands to the
  Arduino Nano and shows what comes back - see docs/Protocol.md.

  Units: the Nano only ever sees metric values (mm, kg, g, deg). All unit
  conversion for input and display happens here.

  The screens themselves are generated by SquareLine Studio (libraries/ui).
  A few things are added or re-labelled in code in setupExtraWidgets() so the
  SquareLine project did not have to change.

  Before uploading: File > Preferences > Sketchbook location = the "Screen"
  folder (the parent of this "ui" folder). See docs/Setup.md.
*/
#include <lvgl.h>
#include <TFT_eSPI.h>
#include <ui.h>
#include <Wire.h>
#include <stdarg.h>

#define SCREEN_FW_VERSION "0.3.0"

// ------------------------------------------------------------ Nano link
// These are the pins of the CYD's 4-pin serial connector (shared with USB).
// If the screen cannot hear the Nano, RX is the pin to move - see docs/Wiring.md.
#define NANO_BAUD    9600        // must match SERIAL_BAUD in the Nano's Config.h
#define NANO_RX_PIN  3
#define NANO_TX_PIN  1
#define NanoSerial   Serial1

#define PING_PERIOD_MS     2000     // how often to check the Nano is there
#define LINK_TIMEOUT_MS    5000     // nothing heard for this long = link down
#define SEND_GAP_MS        30       // pause between queued commands (the Nano's buffer is small)
#define LEVEL_TIMEOUT_MS   130000   // a little longer than the Nano's own limit
#define BALANCE_TIMEOUT_MS 8000
#define TARE_TIMEOUT_MS    5000

// ------------------------------------------------------------ balance weight position
// The tire code gives the rim's bead seat diameter. The weight does not sit
// exactly there, so its radius is the rim radius plus one of these offsets.
// ESTIMATES - measure your wheels and weights and adjust.
#define CLIP_ON_OFFSET_MM    10.0f    // clip-on weight on the rim flange (outside the bead seat)
#define STICK_ON_OFFSET_MM  -15.0f    // stick-on weight inside the barrel

// ------------------------------------------------------------ touch (CST816D, bit-banged over I2C)
#define I2C_SDA 33
#define I2C_SCL 32
#define TOUCH_ADDR 0x15

#define SCREEN_WIDTH 240  // Your actual screen resolution
#define SCREEN_HEIGHT 320
#define X_MIN 30  // Set these to 0 and touch near the screen boarder to get these values
#define X_MAX 210
#define Y_MIN 9
#define Y_MAX 300
bool InvertXY = false;  // enable/disable Inxerting the X and Y axis
bool MirrorX = true;   // enable/disable Mirroring the X axis
bool MirrorY = false;   // enable/disable Mirroring the Y axis

// ------------------------------------------------------------ state
// Last balance result, always metric
float resAngleDeg = 0;
float resMassG    = 0;
float resTotalKg  = 0;
bool  haveResult  = false;

bool  tireEntered = false;

enum Waiting { WAIT_NONE, WAIT_LEVEL, WAIT_BALANCE, WAIT_TARE };
Waiting  waiting      = WAIT_NONE;
uint32_t waitDeadline = 0;        // 0 = wait forever (leveling with Auto Stop off)

bool     linkUp       = false;
uint32_t lastHeardMs  = 0;
uint32_t lastPingMs   = 0;
uint32_t rxBytes      = 0;        // every byte received from the Nano
uint32_t rxBadLines   = 0;        // lines thrown away (bad checksum or too long)

// Non-text bytes on RX usually mean the Nano is being programmed over its USB
// (its bootloader answers at a different baud rate). The screen then stops
// transmitting for QUIET_MS so its pings cannot corrupt the upload.
#define QUIET_MS 10000
bool     quiet        = false;
uint32_t quietUntil   = 0;

// Sliders that are dragged: send the newest value at most every 100 ms
bool pitchTrimPending = false, rollTrimPending = false, laserAnglePending = false;
uint32_t lastSliderSendMs = 0;

lv_obj_t *statusLabel   = NULL;   // bottom-left corner, on every screen
lv_obj_t *messageBox    = NULL;
lv_obj_t *weightPosSwitch = NULL;
lv_obj_t *weightPosLabel  = NULL;
uint32_t  statusNoteUntil = 0;

/*Don't forget to set Sketchbook location in File/Preferences to the path of your UI project (the parent foder of this INO file)*/

/*Change to your screen resolution*/
static const uint16_t screenWidth  = 320;
static const uint16_t screenHeight = 240;

static lv_disp_draw_buf_t draw_buf;
static lv_color_t buf[ screenWidth * screenHeight / 10 ];

TFT_eSPI tft = TFT_eSPI(screenWidth, screenHeight); /* TFT instance */

// ============================================================ display + touch drivers
/* Display flushing */
void my_disp_flush( lv_disp_drv_t *disp, const lv_area_t *area, lv_color_t *color_p )
{
    uint32_t w = ( area->x2 - area->x1 + 1 );
    uint32_t h = ( area->y2 - area->y1 + 1 );

    tft.startWrite();
    tft.setAddrWindow( area->x1, area->y1, w, h );
    tft.pushColors( ( uint16_t * )&color_p->full, w * h, true );
    tft.endWrite();

    lv_disp_flush_ready( disp );
}

// Function to process touch data
void processTouchData(uint16_t &touchX, uint16_t &touchY, bool &touched) {
  Wire.beginTransmission(TOUCH_ADDR);
  Wire.write(0x00); // Basically wakes up the chip to ask it for stuff
  Wire.endTransmission(false);

  Wire.requestFrom(TOUCH_ADDR, 9);

  if (Wire.available() == 9) {
    uint8_t buf[9];
    for (int i = 0; i < 9; i++) {
      buf[i] = Wire.read();
    }

    uint8_t fingerNum = buf[2];
    if (fingerNum == 1) {
      uint16_t rawX = (buf[3] << 8) | buf[4];
      uint16_t rawY = (buf[5] << 8) | buf[6];

      uint16_t tempX = (rawX & 0x8000) ? (rawX - 0x8000) : rawX;
      uint16_t tempY = rawY;

      if (MirrorX) {
        tempX = map(tempX, X_MAX, X_MIN, 0, SCREEN_WIDTH);
      } else {
        tempX = map(tempX, X_MIN, X_MAX, 0, SCREEN_WIDTH);
      }

      if (MirrorY) {
        tempY = map(tempY, Y_MAX, Y_MIN, 0, SCREEN_HEIGHT);
      } else {
        tempY = map(tempY, Y_MIN, Y_MAX, 0, SCREEN_HEIGHT);
      }

      uint16_t SCREEN_X = SCREEN_WIDTH;
      uint16_t SCREEN_Y = SCREEN_HEIGHT;

      if (InvertXY) {
        uint16_t tempXMirror = tempY;
        tempY = tempX;
        tempX = tempXMirror;
        uint16_t SCREEN_HEIGHTMirror = SCREEN_Y;
        SCREEN_Y = SCREEN_WIDTH;
        SCREEN_X = SCREEN_HEIGHTMirror;
      }

      // Validate X/Y before updating
      if (tempX <= SCREEN_X && tempY <= SCREEN_Y) {
        touchX = tempX;
        touchY = tempY;
        touched = true; // A touch is detected
      }
      else {
        touched = false; // No valid touch data
      }
    } else {
      touched = false; // No touch or multi-touch, so set to false
    }
  }
}

/*Read the touchpad*/
void my_touchpad_read( lv_indev_drv_t * indev_driver, lv_indev_data_t * data )
{
    uint16_t touchX = 0, touchY = 0;
    bool touched = false;

    // Call function to get touch data and update x, y, touched
    processTouchData(touchY, touchX, touched);

    if( !touched )
    {
        data->state = LV_INDEV_STATE_REL;
    }
    else
    {
        data->state = LV_INDEV_STATE_PR;

        /*Set the coordinates*/
        data->point.x = touchX;
        data->point.y = touchY;
    }
}

// ============================================================ sending to the Nano
// Commands go through a small queue and leave one every SEND_GAP_MS so a burst
// (for example all the settings after the Nano restarts) cannot overflow the
// Nano's 64-byte receive buffer. Every line gets a "*XX" checksum.
#define TXQ_SIZE 24
#define TXQ_LEN  24
static char     txq[TXQ_SIZE][TXQ_LEN];
static uint8_t  txqHead = 0, txqCount = 0;
static uint32_t lastSendMs = 0;

static void nanoWriteLine(const char *cmd) {
  uint8_t x = 0;
  for (const char *p = cmd; *p; p++) x ^= (uint8_t)*p;
  NanoSerial.printf("%s*%02X\n", cmd, x);
  lastSendMs = millis();
}

// Queue a command, printf style: nanoSend("Kp%d", 30);
void nanoSend(const char *fmt, ...) {
  if (txqCount >= TXQ_SIZE) return;                  // queue full: drop (should never happen)
  va_list args;
  va_start(args, fmt);
  vsnprintf(txq[(txqHead + txqCount) % TXQ_SIZE], TXQ_LEN, fmt, args);
  va_end(args);
  txqCount++;
}

// For Stop / Cancel: forget anything still queued and send right now.
void nanoSendNow(const char *cmd) {
  txqCount = 0;
  nanoWriteLine(cmd);
}

static void nanoSendTick(uint32_t now) {
  if (quiet || txqCount == 0 || now - lastSendMs < SEND_GAP_MS) return;
  nanoWriteLine(txq[txqHead]);
  txqHead = (txqHead + 1) % TXQ_SIZE;
  txqCount--;
}

// ============================================================ helpers
static bool isChecked(lv_obj_t *obj) {
  return lv_obj_has_state(obj, LV_STATE_CHECKED);
}

// Short note in the bottom-left corner for a few seconds, then back to the link state.
void statusNote(const char *text) {
  lv_label_set_text(statusLabel, text);
  statusNoteUntil = millis() + 3000;
}

// While the link is down the counters tell you why:
//   rx stays 0      -> nothing at all is arriving on NANO_RX_PIN (wiring)
//   rx counts up,
//   bad counts up   -> bytes arrive but are garbled (signal level / baud rate)
static void showLinkState() {
  if (quiet) {
    lv_label_set_text(statusLabel, "Paused: noise on RX");
  } else if (linkUp) {
    lv_label_set_text(statusLabel, "Nano OK");
  } else {
    char txt[40];
    snprintf(txt, sizeof(txt), "No link rx:%lu bad:%lu", (unsigned long)rxBytes, (unsigned long)rxBadLines);
    lv_label_set_text(statusLabel, txt);
  }
  lv_obj_set_style_text_color(statusLabel, linkUp ? lv_palette_main(LV_PALETTE_GREEN) : lv_palette_main(LV_PALETTE_RED), 0);
}

static void messageBoxDeleted(lv_event_t * e) {
  messageBox = NULL;
}

// Pop-up with a close button. A new message replaces the old one.
void showMessage(const char *title, const char *text) {
  if (messageBox) lv_msgbox_close(messageBox);
  messageBox = lv_msgbox_create(NULL, title, text, NULL, true);
  lv_obj_center(messageBox);
  lv_obj_add_event_cb(messageBox, messageBoxDeleted, LV_EVENT_DELETE, NULL);
}

static void backToOptionMenu() {
  if (lv_scr_act() != ui_OptionMenu) {
    lv_scr_load_anim(ui_OptionMenu, LV_SCR_LOAD_ANIM_FADE_ON, 250, 0, false);
  }
}

static void startWaiting(Waiting what, uint32_t timeoutMs) {
  waiting = what;
  waitDeadline = timeoutMs ? millis() + timeoutMs : 0;
}

// ---- units
static bool addedWeightInGrams() { return isChecked(ui_TestWeightSwitch1); }   // off = oz, on = g
static bool totalWeightInLbs()   { return isChecked(ui_TestWeightSwitch2); }   // off = kg, on = lbs

// Redraw the result panel from the stored metric values in the selected units.
void refreshResults() {
  bool grams = addedWeightInGrams();
  bool lbs   = totalWeightInLbs();
  lv_label_set_text(ui_WeightAddedUnitLabel, grams ? "g" : "oz");
  lv_label_set_text(ui_TotalWeightUnitLabel, lbs ? "lbs" : "kg");

  if (!haveResult) {
    lv_label_set_text(ui_WeightAddedValueLabel, "--");
    lv_label_set_text(ui_WeightAngleValueLabel, "--");
    lv_label_set_text(ui_TotalWeightValueLabel, "--");
    return;
  }
  char txt[16];
  snprintf(txt, sizeof(txt), "%.2f", grams ? resMassG : resMassG / 28.3495f);
  lv_label_set_text(ui_WeightAddedValueLabel, txt);
  snprintf(txt, sizeof(txt), "%.2f", resAngleDeg);
  lv_label_set_text(ui_WeightAngleValueLabel, txt);
  snprintf(txt, sizeof(txt), "%.2f", lbs ? resTotalKg * 2.20462f : resTotalKg);
  lv_label_set_text(ui_TotalWeightValueLabel, txt);
}

// ---- things sent in more than one place
static void sendTireInfo() {
  int   treadMm   = lv_slider_get_value(ui_TreadWidthSlider);
  int   aspectPct = lv_slider_get_value(ui_SideWallPercentSlider);
  float rimMm     = lv_slider_get_value(ui_RimDiameterSlider) * 25.4f;          // inches -> mm
  float offsetMm  = isChecked(weightPosSwitch) ? STICK_ON_OFFSET_MM : CLIP_ON_OFFSET_MM;

  nanoSend("TreadW%d", treadMm);
  nanoSend("SideWall%d", aspectPct);
  nanoSend("RimD%.1f", rimMm);
  nanoSend("WeightR%.1f", rimMm / 2 + offsetMm);
}

static void sendSwitches() {
  nanoSend(isChecked(ui_AutoStopCheckbox) ? "AutoStopOn" : "AutoStopOff");
  nanoSend(isChecked(ui_MassCompSwitch) ? "MassCompOn" : "MassCompOff");
  nanoSend(isChecked(ui_TestWeightSwitch) ? "TestMassOn" : "TestMassOff");
}

// Everything the Nano forgets when it restarts. Sent whenever the link comes up.
// Speeds and Kp are NOT sent here: the Nano keeps its own saved values until
// "Enter Speed" is pressed.
static void syncNano() {
  sendSwitches();
  nanoSend("PitchTrim%.1f", lv_slider_get_value(ui_PitchOffsetSlider) / 10.0f);
  nanoSend("RollTrim%.1f", lv_slider_get_value(ui_RollOffsetSlider) / 10.0f);
  nanoSend("LaserAngle%d", (int)lv_slider_get_value(ui_ManualLaserAngleSlider));
  nanoSend(isChecked(ui_ManualLaserSwitch) ? "ManualLaserOn" : "ManualLaserOff");
  if (tireEntered) sendTireInfo();
}

// ============================================================ receiving from the Nano
static const char *errorText(const char *code) {
  if (!strcasecmp(code, "Busy"))         return "The Nano is busy with something else.";
  if (!strcasecmp(code, "BaseTilt"))     return "The frame is tilted too far to level. Move it to flatter ground.";
  if (!strcasecmp(code, "MPUTop"))       return "Platform angle sensor is not responding.";
  if (!strcasecmp(code, "MPUBottom"))    return "Frame angle sensor is not responding.";
  if (!strcasecmp(code, "LevelTimeout")) return "Leveling took too long and was stopped.";
  if (!strcasecmp(code, "Scale"))        return "A load cell is not responding.";
  if (!strcasecmp(code, "TireData"))     return "Enter the tire size on the Tire Info tab first.";
  if (!strcasecmp(code, "NoLoad"))       return "No tire detected on the load cells.";
  if (!strcasecmp(code, "NoTare"))       return "Press Tare with the arms empty first.";
  if (!strcasecmp(code, "Cal"))          return "Load cell calibration failed.";
  return code;
}

// Value of "Key<number>" inside a line, e.g. findValue(line, "WeightMass", v)
static bool findValue(const char *line, const char *key, float &value) {
  const char *p = strstr(line, key);
  if (!p) return false;
  p += strlen(key);
  char *end;
  value = strtof(p, &end);
  return end != p;
}

static void handleNanoLine(char *line) {
  // Checksum: "*XX" at the end, XOR of everything before the '*'
  char *star = strrchr(line, '*');
  if (star) {
    uint8_t x = 0;
    for (char *p = line; p < star; p++) x ^= (uint8_t)*p;
    if (strlen(star + 1) != 2 || (uint8_t)strtol(star + 1, NULL, 16) != x) {          // damaged: the Nano will resend
      rxBadLines++;
      return;
    }
    *star = 0;
  }
  else if (line[0] != '#' && strncmp(line, "Pong", 4) && strncmp(line, "Ready", 5)) {
    rxBadLines++;                                    // nothing else is ever sent without a checksum
    return;
  }

  lastHeardMs = millis();
  bool wasUp = linkUp;
  if (!linkUp) {
    linkUp = true;
    showLinkState();
    syncNano();
  }

  if (line[0] == '#') return;                        // debug text for humans
  if (!strncmp(line, "Pong", 4)) return;
  if (!strncmp(line, "Ready", 5)) {                  // the Nano has just restarted
    if (wasUp) syncNano();
    return;
  }

  // Everything else is an event, and the Nano repeats events until it gets an Ack.
  if (!strncmp(line, "LevelCompleted", 14)) {
    nanoSend("Ack");
    if (waiting == WAIT_LEVEL) {
      waiting = WAIT_NONE;
      backToOptionMenu();
      statusNote("Level done");
    }
  }
  else if (!strncmp(line, "TareCompleted", 13)) {
    nanoSend("Ack");
    if (waiting == WAIT_TARE) {
      waiting = WAIT_NONE;
      statusNote("Tare done");
    }
  }
  else if (!strncmp(line, "BalanceCompleted", 16)) {
    float angle, mass, total;
    if (!findValue(line, "WeightAngle", angle) || !findValue(line, "WeightMass", mass) || !findValue(line, "TotalWeight", total)) return;
    nanoSend("Ack");
    resAngleDeg = angle;
    resMassG    = mass;
    resTotalKg  = total;
    haveResult  = true;
    refreshResults();
    if (waiting == WAIT_BALANCE) {
      waiting = WAIT_NONE;
      backToOptionMenu();
    }
  }
  else if (!strncmp(line, "Err ", 4)) {
    nanoSend("Ack");
    waiting = WAIT_NONE;
    backToOptionMenu();
    showMessage("Error", errorText(line + 4));
  }
}

static void nanoReceiveTick() {
  static char    rx[96];
  static uint8_t rxLen = 0;
  static bool    rxOverflow = false;

  while (NanoSerial.available()) {
    char c = NanoSerial.read();
    rxBytes++;
    uint8_t b = (uint8_t)c;
    if (b > 0x7E || (b < 0x20 && c != '\n' && c != '\r' && c != '\t')) {
      if (!quiet) {
        quiet = true;
        showLinkState();
      }
      quietUntil = millis() + QUIET_MS;
      rxOverflow = true;                             // drop this line
      continue;
    }
    if (c == '\n' || c == '\r') {
      if (rxLen > 0 && !rxOverflow) {
        rx[rxLen] = 0;
        handleNanoLine(rx);
      } else if (rxOverflow) {
        rxBadLines++;
      }
      rxLen = 0;
      rxOverflow = false;
    } else if (rxLen < sizeof(rx) - 1) {
      rx[rxLen++] = c;
    } else {
      rxOverflow = true;
    }
  }
}

// Ping, link state, timeouts and throttled slider values.
static void linkTick(uint32_t now) {
  if (quiet && (int32_t)(now - quietUntil) >= 0) {
    quiet = false;
    showLinkState();
  }

  if (now - lastPingMs >= PING_PERIOD_MS) {
    lastPingMs = now;
    if (!quiet) nanoSend("Ping");
    if (!linkUp && !statusNoteUntil) showLinkState();      // keep the rx / bad counters fresh
  }

  if (linkUp && (int32_t)(now - lastHeardMs) > (int32_t)LINK_TIMEOUT_MS) {
    linkUp = false;
    showLinkState();
  }

  if (statusNoteUntil && (int32_t)(now - statusNoteUntil) >= 0) {
    statusNoteUntil = 0;
    showLinkState();
  }

  if (waiting != WAIT_NONE && waitDeadline && (int32_t)(now - waitDeadline) >= 0) {
    waiting = WAIT_NONE;
    nanoSendNow("Stop");
    backToOptionMenu();
    showMessage("No reply", "The Nano did not answer in time. Check the serial wires (see docs/Wiring.md).");
  }

  if (now - lastSliderSendMs >= 100) {
    if (pitchTrimPending) {
      pitchTrimPending = false; lastSliderSendMs = now;
      nanoSend("PitchTrim%.1f", lv_slider_get_value(ui_PitchOffsetSlider) / 10.0f);
    } else if (rollTrimPending) {
      rollTrimPending = false; lastSliderSendMs = now;
      nanoSend("RollTrim%.1f", lv_slider_get_value(ui_RollOffsetSlider) / 10.0f);
    } else if (laserAnglePending) {
      laserAnglePending = false; lastSliderSendMs = now;
      nanoSend("LaserAngle%d", (int)lv_slider_get_value(ui_ManualLaserAngleSlider));
    }
  }
}

// ============================================================ UI event handlers
// Buttons
void LevelButton_event_handler(lv_event_t * e) {
  if (lv_event_get_code(e) != LV_EVENT_CLICKED) return;
  bool autoStop = isChecked(ui_AutoStopCheckbox);
  nanoSend(autoStop ? "AutoStopOn" : "AutoStopOff");
  nanoSend("Level");
  startWaiting(WAIT_LEVEL, autoStop ? LEVEL_TIMEOUT_MS : 0);
}
void LevelCancelButton_event_handler(lv_event_t * e) {
  if (lv_event_get_code(e) != LV_EVENT_CLICKED) return;
  waiting = WAIT_NONE;
  nanoSendNow("LevelCancel");
}
void CalibrateButton_event_handler(lv_event_t * e) {        // the "Tare" button
  if (lv_event_get_code(e) != LV_EVENT_CLICKED) return;
  nanoSend("Tare");
  startWaiting(WAIT_TARE, TARE_TIMEOUT_MS);
  statusNote("Taring...");
}
void BalanceButton_event_handler(lv_event_t * e) {
  if (lv_event_get_code(e) != LV_EVENT_CLICKED) return;
  if (tireEntered) sendTireInfo();      // in case the Nano restarted since it was entered
  nanoSend("Balance");
  startWaiting(WAIT_BALANCE, BALANCE_TIMEOUT_MS);
}
void BalanceCancelButton_event_handler(lv_event_t * e) {
  if (lv_event_get_code(e) != LV_EVENT_CLICKED) return;
  waiting = WAIT_NONE;
  nanoSendNow("BalanceCancel");
}
void LaserButton_event_handler(lv_event_t * e) {
  if (lv_event_get_code(e) != LV_EVENT_CLICKED) return;
  nanoSend("LaserToggle");
}
void TireInfoEnterButton_event_handler(lv_event_t * e) {
  if (lv_event_get_code(e) != LV_EVENT_CLICKED) return;
  tireEntered = true;
  sendTireInfo();
  statusNote("Tire info sent");
}
void SpeedEnterButton_event_handler(lv_event_t * e) {
  if (lv_event_get_code(e) != LV_EVENT_CLICKED) return;
  nanoSend("MinSpeed%d", (int)lv_slider_get_value(ui_MinSpeedSlider));
  nanoSend("MaxSpeed%d", (int)lv_slider_get_value(ui_MaxSpeedSlider));
  nanoSend("Kp%d", (int)lv_slider_get_value(ui_SpeedCurveSlider));     // re-labelled "Level Gain Kp"
  statusNote("Speeds sent");
}

// Sliders that send while they move (throttled in linkTick)
void PitchOffsetSlider_event_handler(lv_event_t * e) {
  if (lv_event_get_code(e) == LV_EVENT_VALUE_CHANGED) pitchTrimPending = true;
}
void RollOffsetSlider_event_handler(lv_event_t * e) {
  if (lv_event_get_code(e) == LV_EVENT_VALUE_CHANGED) rollTrimPending = true;
}
void ManualLaserAngleSlider_event_handler(lv_event_t * e) {
  if (lv_event_get_code(e) == LV_EVENT_VALUE_CHANGED && isChecked(ui_ManualLaserSwitch)) laserAnglePending = true;
}

// Switches and checkbox
void TestWeightSwitch_event_cb(lv_event_t * e) {
  nanoSend(isChecked(ui_TestWeightSwitch) ? "TestMassOn" : "TestMassOff");
}
void MassCompSwitch_event_cb(lv_event_t * e) {
  nanoSend(isChecked(ui_MassCompSwitch) ? "MassCompOn" : "MassCompOff");
}
void ManualLaserSwitch_event_cb(lv_event_t * e) {
  if (isChecked(ui_ManualLaserSwitch)) {
    nanoSend("LaserAngle%d", (int)lv_slider_get_value(ui_ManualLaserAngleSlider));
    nanoSend("ManualLaserOn");
  } else {
    nanoSend("ManualLaserOff");
  }
}
void AutoStopCheckbox_event_handler(lv_event_t * e) {
  nanoSend(isChecked(ui_AutoStopCheckbox) ? "AutoStopOn" : "AutoStopOff");
}
void UnitsSwitch_event_cb(lv_event_t * e) {
  refreshResults();
}
void WeightPosSwitch_event_cb(lv_event_t * e) {
  lv_label_set_text(weightPosLabel, isChecked(weightPosSwitch) ? "Weight:\nStick-on" : "Weight:\nClip-on");
  if (tireEntered) sendTireInfo();
}

// ============================================================ setup
// Widgets added or changed in code, on top of the SquareLine screens.
static void setupExtraWidgets() {
  // Link / status line, visible on every screen
  statusLabel = lv_label_create(lv_layer_top());
  lv_obj_align(statusLabel, LV_ALIGN_BOTTOM_LEFT, 4, -2);
  showLinkState();

  // Tire Info tab: where the balance weight will be placed
  weightPosSwitch = lv_switch_create(ui_Tire_Info_Tab);
  lv_obj_set_width(weightPosSwitch, 100);
  lv_obj_set_height(weightPosSwitch, 40);
  lv_obj_set_x(weightPosSwitch, lv_pct(35));
  lv_obj_set_y(weightPosSwitch, lv_pct(35));
  lv_obj_set_align(weightPosSwitch, LV_ALIGN_CENTER);
  weightPosLabel = lv_label_create(weightPosSwitch);
  lv_obj_set_align(weightPosLabel, LV_ALIGN_CENTER);
  lv_obj_set_style_text_align(weightPosLabel, LV_TEXT_ALIGN_CENTER, LV_PART_MAIN | LV_STATE_DEFAULT);
  lv_label_set_text(weightPosLabel, "Weight:\nClip-on");
  lv_obj_add_event_cb(weightPosSwitch, WeightPosSwitch_event_cb, LV_EVENT_VALUE_CHANGED, NULL);

  // Debug tab: the old "Speed Curve Exp." slider is now the leveling PID gain.
  // Slider start values match the Nano's tuned defaults (Settings.ino), so
  // pressing "Enter Speed" without moving them changes nothing.
  lv_label_set_text(ui_SpeedCurveSliderLabel, "Level Gain Kp");
  lv_slider_set_range(ui_SpeedCurveSlider, 10, 400);
  lv_slider_set_value(ui_SpeedCurveSlider, 200, LV_ANIM_OFF);
  lv_label_set_text(ui_SpeedCurveValueLabel, "200");
  lv_slider_set_value(ui_MinSpeedSlider, 20, LV_ANIM_OFF);
  lv_label_set_text(ui_MinSpeedValueLabel, "20");
  lv_slider_set_value(ui_MaxSpeedSlider, 255, LV_ANIM_OFF);
  lv_label_set_text(ui_MaxSpeedValueLabel, "255");

  // Debug tab: these trim the Nano's saved offsets by up to +-1.0 deg
  lv_label_set_text(ui_PitchOffsetSliderLabel, "Pitch Trim (deg tenths)");
  lv_label_set_text(ui_RollOffsetSliderLabel, "Roll Trim (deg tenths)");

  // Result panel starts empty instead of showing placeholder text
  refreshResults();
}

void setup() {
  Wire.begin(I2C_SDA, I2C_SCL);
  NanoSerial.begin(NANO_BAUD, SERIAL_8N1, NANO_RX_PIN, NANO_TX_PIN);

  lv_init();

  tft.begin();          /* TFT init */
  tft.setRotation( 1 ); /* Landscape orientation, flipped */

  lv_disp_draw_buf_init( &draw_buf, buf, NULL, screenWidth * screenHeight / 10 );

  /*Initialize the display*/
  static lv_disp_drv_t disp_drv;
  lv_disp_drv_init( &disp_drv );
  disp_drv.hor_res = screenWidth;
  disp_drv.ver_res = screenHeight;
  disp_drv.flush_cb = my_disp_flush;
  disp_drv.draw_buf = &draw_buf;
  lv_disp_drv_register( &disp_drv );

  /*Initialize the input device driver*/
  static lv_indev_drv_t indev_drv;
  lv_indev_drv_init( &indev_drv );
  indev_drv.type = LV_INDEV_TYPE_POINTER;
  indev_drv.read_cb = my_touchpad_read;
  lv_indev_drv_register( &indev_drv );

  ui_init();
  setupExtraWidgets();

  // Buttons
  lv_obj_add_event_cb(ui_CalibrateButton, CalibrateButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_LaserButton, LaserButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_BalanceButton, BalanceButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_BalanceCancelButton, BalanceCancelButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_LevelButton, LevelButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_LevelCancelButton, LevelCancelButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_TireInfoEnterButton, TireInfoEnterButton_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_SpeedEnterButton, SpeedEnterButton_event_handler, LV_EVENT_ALL, NULL);
  // Sliders
  lv_obj_add_event_cb(ui_PitchOffsetSlider, PitchOffsetSlider_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_RollOffsetSlider, RollOffsetSlider_event_handler, LV_EVENT_ALL, NULL);
  lv_obj_add_event_cb(ui_ManualLaserAngleSlider, ManualLaserAngleSlider_event_handler, LV_EVENT_ALL, NULL);
  // Switches
  lv_obj_add_event_cb(ui_TestWeightSwitch, TestWeightSwitch_event_cb, LV_EVENT_VALUE_CHANGED, NULL);
  lv_obj_add_event_cb(ui_MassCompSwitch, MassCompSwitch_event_cb, LV_EVENT_VALUE_CHANGED, NULL);
  lv_obj_add_event_cb(ui_ManualLaserSwitch, ManualLaserSwitch_event_cb, LV_EVENT_VALUE_CHANGED, NULL);
  lv_obj_add_event_cb(ui_TestWeightSwitch1, UnitsSwitch_event_cb, LV_EVENT_VALUE_CHANGED, NULL);   // added weight: oz / g
  lv_obj_add_event_cb(ui_TestWeightSwitch2, UnitsSwitch_event_cb, LV_EVENT_VALUE_CHANGED, NULL);   // total weight: kg / lbs
  // Checkbox
  lv_obj_add_event_cb(ui_AutoStopCheckbox, AutoStopCheckbox_event_handler, LV_EVENT_VALUE_CHANGED, NULL);
}

void loop()
{
  lv_timer_handler(); /* let the GUI do its work */

  // Receive first, THEN read the clock, so lastHeardMs can never be later
  // than "now" (that made "now - lastHeardMs" wrap and drop the link).
  nanoReceiveTick();
  uint32_t now = millis();
  linkTick(now);
  nanoSendTick(now);

  delay(5);
}
